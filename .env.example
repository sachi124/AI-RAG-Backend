# Any value works for Ollama. Use a real key and remove OPENAI_BASE_URL to use OpenAI.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_CHAT_MODEL=llama3.2
OPENAI_EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=palm_mind_documents_ollama
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./palm_mind.db
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
REDIS_MEMORY_TTL_SECONDS=86400
MAX_UPLOAD_SIZE_MB=15
